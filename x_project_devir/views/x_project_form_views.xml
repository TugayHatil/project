<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x.project.form Tree View -->
    <record id="x_project_form_tree_view" model="ir.ui.view">
        <field name="name">x.project.form.tree</field>
        <field name="model">x.project.form</field>
        <field name="arch" type="xml">
            <tree string="Proje Formları">
                <field name="name"/>
                <field name="project_id"/>
                <field name="template_id"/>
                <field name="template_version"/>
                <field name="state"/>
                <field name="completion_percentage" widget="percentage"/>
                <field name="filled_by"/>
                <field name="filled_date"/>
            </tree>
        </field>
    </record>

    <!-- x.project.form Form View -->
    <record id="x_project_form_form_view" model="ir.ui.view">
        <field name="name">x.project.form.form</field>
        <field name="model">x.project.form</field>
        <field name="arch" type="xml">
            <form string="Proje Formu">
                <header>
                    <button name="action_start" string="Formu Başlat" type="object" class="btn-primary" states="draft"/>
                    <button name="action_edit_form" string="Formu Düzenle" type="object" states="completed,approved"/>
                    <button name="action_complete" string="Tamamla" type="object" class="btn-primary" states="in_progress"/>
                    <button name="action_approve" string="Onayla" type="object" class="btn-primary" states="completed"/>
                    <button name="action_draft" string="Taslak Olarak İşaretle" type="object" states="in_progress,completed,approved"/>
                    <button name="action_print_pdf" string="PDF Oluştur" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                        </group>
                        <group>
                            <field name="filled_by"/>
                            <field name="filled_date"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                    
                    <notebook>
                        <page string="İlerleme">
                            <group>
                                <group>
                                    <field name="completion_percentage" widget="percentage"/>
                                    <field name="total_questions" readonly="1"/>
                                    <field name="answered_questions" readonly="1"/>
                                </group>
                                <group>
                                    <field name="missing_required_questions" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Sorular" attrs="{'invisible': [('state', '=', 'draft')]}">
                            <field name="answer_ids">
                                <tree editable="bottom">
                                    <field name="question_id" readonly="1"/>
                                    <field name="is_visible" invisible="1"/>
                                    <field name="value_text" attrs="{'invisible': [('question_id.answer_type', '!=', 'text')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_long_text" attrs="{'invisible': [('question_id.answer_type', '!=', 'long_text')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_date" attrs="{'invisible': [('question_id.answer_type', '!=', 'date')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_datetime" attrs="{'invisible': [('question_id.answer_type', '!=', 'datetime')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_integer" attrs="{'invisible': [('question_id.answer_type', '!=', 'integer')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_float" attrs="{'invisible': [('question_id.answer_type', '!=', 'float')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_percentage" attrs="{'invisible': [('question_id.answer_type', '!=', 'percentage')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_boolean" attrs="{'invisible': [('question_id.answer_type', '!=', 'boolean')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_user_id" attrs="{'invisible': [('question_id.answer_type', '!=', 'many2one_user')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_user_ids" attrs="{'invisible': [('question_id.answer_type', '!=', 'many2many_user')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_partner_id" attrs="{'invisible': [('question_id.answer_type', '!=', 'partner')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_selection" attrs="{'invisible': [('question_id.answer_type', '!=', 'selection')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="value_multi_selection" attrs="{'invisible': [('question_id.answer_type', '!=', 'multi_selection')], 'readonly': [('is_visible', '=', False)]}"/>
                                    <field name="attachment_ids" attrs="{'invisible': [('question_id.answer_type', '!=', 'attachment')], 'readonly': [('is_visible', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Dosyalar">
                            <field name="attachment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- x.project.form Action -->
    <record id="x_project_form_action" model="ir.actions.act_window">
        <field name="name">Proje Formları</field>
        <field name="res_model">x.project.form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz proje formu yok.
            </p>
            <p>
                Projeniz için devir formu oluşturarak başlayın.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="x_project_form_menu" 
              name="Proje Formları" 
              parent="x_project_devir.menu_x_project_devir_root"
              action="x_project_form_action"
              sequence="20"/>
</odoo>
