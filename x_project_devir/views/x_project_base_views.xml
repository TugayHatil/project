<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x.project Tree View -->
    <record id="x_project_tree_view" model="ir.ui.view">
        <field name="name">x.project.tree</field>
        <field name="model">x.project</field>
        <field name="arch" type="xml">
            <tree string="Projeler">
                <field name="name"/>
                <field name="x_partner_name"/>
                <field name="x_state"/>
                <field name="x_date1"/>
                <field name="x_date2"/>
            </tree>
        </field>
    </record>

    <!-- x.project Form View -->
    <record id="x_project_view_form" model="ir.ui.view">
        <field name="name">x.project.form</field>
        <field name="model">x.project</field>
        <field name="arch" type="xml">
            <form string="Proje Deneme">
                <header>
                    <button name="action_start" string="Başlat" type="object" class="btn-primary" states="draft"/>
                    <button name="action_complete" string="Tamamla" type="object" class="btn-primary" states="in_progress"/>
                    <button name="action_cancel" string="İptal" type="object" states="draft,in_progress"/>
                    <button name="action_draft" string="Taslak" type="object" states="completed,cancelled"/>
                    <field name="x_state" required="1" widget="statusbar" class="o_field_statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_partner_name"/>
                            <field name="x_kontak_name"/>
                        </group>
                        <group>
                            <field name="x_sales_support_names"/>
                            <field name="x_sales_employe_names"/>
                            <field name="x_project_engineer_names"/>
                        </group>
                        <group>
                            <field name="x_date1"/>
                            <field name="x_date4"/>
                            <field name="x_date2"/>
                            <field name="x_date3"/>
                            <field name="x_web_link" widget="url"/>
                        </group>
                        <group>
                            <field name="x_tag_names"/>
                            <field name="x_proje_type_name"/>
                        </group>
                        <group>
                            <field name="x_subcontractor_name"/>
                        </group>
                        <group>
                            <field name="x_tedarikci_names"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description_page" string="Açıklama">
                            <field name="x_description" type="html" options="{'collaborative': true, 'resizable': false}" placeholder="Görev Tanımı..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- x.project Action -->
    <record id="x_project_action" model="ir.actions.act_window">
        <field name="name">Projeler</field>
        <field name="res_model">x.project</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz proje yok.
            </p>
            <p>
                İlk projenizi oluşturarak başlayın.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_x_project_root" 
              name="Projeler" 
              parent="x_project_devir.menu_x_project_devir_root"
              action="x_project_action"
              sequence="5"/>
</odoo>
