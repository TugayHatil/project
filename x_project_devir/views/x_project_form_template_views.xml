<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x.project.form.template Tree View -->
    <record id="x_project_form_template_tree_view" model="ir.ui.view">
        <field name="name">x.project.form.template.tree</field>
        <field name="model">x.project.form.template</field>
        <field name="arch" type="xml">
            <tree string="Form Şablonları">
                <field name="name"/>
                <field name="version"/>
                <field name="active"/>
                <field name="form_count"/>
            </tree>
        </field>
    </record>

    <!-- x.project.form.template Form View -->
    <record id="x_project_form_template_form_view" model="ir.ui.view">
        <field name="name">x.project.form.template.form</field>
        <field name="model">x.project.form.template</field>
        <field name="arch" type="xml">
            <form string="Form Şablonu">
                <header>
                    <button name="action_duplicate" string="Yeni Versiyon Oluştur" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Şablon Adı"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="version"/>
                            <field name="active"/>
                            <field name="form_count"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bölümler">
                            <field name="section_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="question_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- x.project.form.template Action -->
    <record id="x_project_form_template_action" model="ir.actions.act_window">
        <field name="name">Form Şablonları</field>
        <field name="res_model">x.project.form.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz form şablonu yok.
            </p>
            <p>
                İlk form şablonunuzu oluşturarak başlayın.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="x_project_form_template_menu" 
              name="Form Şablonları" 
              parent="x_project_devir.menu_x_project_devir_root"
              action="x_project_form_template_action"
              sequence="10"/>
</odoo>
