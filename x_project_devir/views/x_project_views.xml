<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x_project Form View Extension -->
    <record id="x_project_form_view_devir" model="ir.ui.view">
        <field name="name">x.project.form.view.devir</field>
        <field name="model">x.project</field>
        <field name="inherit_id" ref="x_project_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="devir_form" string="Proje Devir Formu">
                    <div class="alert alert-info">
                        <h4>Proje Devir Formu Özelliği</h4>
                        <p><field name="devir_form_info" readonly="1"/></p>
                        <p><strong>Durum:</strong> <field name="devir_form_enabled" readonly="1"/></p>
                    </div>
                    
                    <div class="alert alert-warning">
                        <p><strong>Not:</strong> Bu özellik şu anda geliştirme aşamasındadır.</p>
                        <p>Tam sürüm yakında eklenecektir.</p>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
