<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x_project Form View Extension -->
    <record id="x_project_form_view_devir" model="ir.ui.view">
        <field name="name">x.project.form.view.devir</field>
        <field name="model">x.project</field>
        <field name="inherit_id" ref="x_project_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="devir_form" string="Proje Devir Formu">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_form" type="object" class="oe_stat_button" icon="fa-plus" attrs="{'invisible': [('active_form_id', '!=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Form Oluştur</span>
                            </div>
                        </button>
                        <button name="action_view_forms" type="object" class="oe_stat_button" icon="fa-list" attrs="{'invisible': [('form_ids', '=', [])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="form_ids" widget="statinfo" nolabel="1"/></span>
                                <span class="o_stat_text">Formlar</span>
                            </div>
                        </button>
                    </div>
                    
                    <group string="Aktif Form Bilgileri" attrs="{'invisible': [('active_form_id', '=', False)]}">
                        <group>
                            <field name="form_state" widget="statusbar" readonly="1"/>
                            <field name="form_version" readonly="1"/>
                            <field name="form_completion" widget="percentage" readonly="1"/>
                        </group>
                        <group>
                            <field name="active_form_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
